# Binance API Credentials
# Get your API keys from: https://testnet.binancefuture.com/ (Testnet) or https://www.binance.com/en/my/settings/api-management (Mainnet)
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_key_here

# Trading Mode
# Set to "true" for Testnet, "false" for Mainnet
TESTNET=true

# Risk Profile
# Options: conservador, normal, agresivo
RISK_PROFILE=normal

# Trading Symbol
# Example: BTCUSDT, ETHUSDT, etc.
SYMBOL=BTCUSDT

# Leverage
LEVERAGE=5

# Circuit Breaker Limits (optional, uses profile defaults if not set)
# DAILY_LOSS_LIMIT_PCT=3.0
# WEEKLY_LOSS_LIMIT_PCT=6.0
# MONTHLY_LOSS_LIMIT_PCT=10.0
# MAX_CONSECUTIVE_LOSSES=4

# Strategy Configuration
MIN_STRATEGIES_FOR_CONFLUENCE=2
MIN_CONFIDENCE_FOR_ENTRY=0.5

# Alert Configuration (optional)
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id

# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
